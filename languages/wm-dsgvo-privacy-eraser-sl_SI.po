#. Plugin Name of the plugin
#: wm-dsgvo-privacy-eraser.php
msgid "WM DSGVO Art. 17 Cryptographic Privacy Eraser"
msgstr "WM GDPR čl. 17 Kriptografski izbris zasebnosti"

#. Plugin URI of the plugin
#: wm-dsgvo-privacy-eraser.php
msgid "https://arnoldwender.com/wordpress-plugins/wm-dsgvo-privacy-eraser/"
msgstr "https://arnoldwender.com/wordpress-plugins/wm-dsgvo-privacy-eraser/"

#. Description of the plugin
#: wm-dsgvo-privacy-eraser.php
msgid ""
"Löschanträge nach Art. 17 DSGVO mit Bestätigungslink an die Adresse; danach "
"werden Kommentare anonymisiert, das Benutzerkonto (außer Administratoren) "
"gelöscht und optional WooCommerce-Rechnungsfelder anonymisiert. Jede "
"Löschung erhält einen HMAC-verketteten Nachweis. Keine rechtliche Prüfung "
"des Antrags."
msgstr ""
"Zahteve za izbris po 17. členu GDPR z enkratno potrditveno povezavo, poslano "
"na e-poštni naslov; nato se komentarji anonimizirajo, uporabniški račun "
"(razen skrbnikov) izbriše, po izbiri pa se anonimizirajo tudi obračunska "
"polja WooCommerce. Vsak izbris prejme z HMAC veriženo potrdilo. Brez pravne "
"presoje."

#. Author of the plugin
#: wm-dsgvo-privacy-eraser.php
msgid "Arnold Wender"
msgstr "Arnold Wender"

